#!/bin/bash
#SBATCH --nodes=2
#SBATCH --exclusive
#SBATCH --account=ACCOUNT
#SBATCH --job-name=JOB_NAME
#SBATCH --partition=PARTITION
#SBATCH --time=4:0:0
#SBATCH --dependency=singleton

# Copyright (c) 2025, NVIDIA CORPORATION.  All rights reserved.

set -eoux pipefail

########################################################
# Function to detect if SLURM cluster uses GRES
########################################################
maybe_gres_arg() {
  if sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep -q "gpu:"; then
    # Removes socket spec (S:0-3) to get raw GPU count
    if [[ $GPUS_PER_NODE -ne $(sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep "gpu:" | cut -d'(' -f1 | awk -F: '{print $NF}') ]]; then
      echo "Error: GPUS_PER_NODE=$GPUS_PER_NODE but GRES detected mismatch." >&2
      exit 1
    fi
    echo "--gres=gpu:${GPUS_PER_NODE}"
    return
  fi
  echo ""
}

########################################################
# User defined variables
########################################################
export OMP_NUM_THREADS=16
CONTAINER=$CONTAINER
MOUNTS=$MOUNTS
COMMAND=${COMMAND:-}  

# Ports
NODE_MANAGER_PORT=${NODE_MANAGER_PORT:-53001}
OBJECT_MANAGER_PORT=${OBJECT_MANAGER_PORT:-53003}
RUNTIME_ENV_AGENT_PORT=${RUNTIME_ENV_AGENT_PORT:-53005}
DASHBOARD_AGENT_GRPC_PORT=${DASHBOARD_AGENT_GRPC_PORT:-53007}
METRICS_EXPORT_PORT=${METRICS_EXPORT_PORT:-53009}
PORT=${PORT:-54514}
RAY_CLIENT_SERVER_PORT=${RAY_CLIENT_SERVER_PORT:-10001}
DASHBOARD_PORT=${DASHBOARD_PORT:-8265}
DASHBOARD_AGENT_LISTEN_PORT=${DASHBOARD_AGENT_LISTEN_PORT:-52365}

# ulimit adjustments for Ray
ulimit -Sn 65535 || echo "Warning: could not set ulimit"

MIN_WORKER_PORT=${MIN_WORKER_PORT:-61000}
MAX_WORKER_PORT=${MAX_WORKER_PORT:-65535}

# Ray Env
export RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
unset UV_CACHE_DIR

# Logging
LOG_DIR="$SLURM_SUBMIT_DIR/$SLURM_JOB_ID-logs"
mkdir -p $LOG_DIR

GPUS_PER_NODE=${GPUS_PER_NODE:-8}
GRES_ARG=$(maybe_gres_arg)
CPUS_PER_WORKER=${CPUS_PER_WORKER:-112}

COMMON_SRUN_ARGS="$GRES_ARG"
COMMON_SRUN_ARGS+=" --no-container-mount-home"
COMMON_SRUN_ARGS+=" --mpi=pmix"
COMMON_SRUN_ARGS+=" --container-mounts=$MOUNTS"
COMMON_SRUN_ARGS+=" --container-image=$CONTAINER"
COMMON_SRUN_ARGS+=" --container-workdir=$SLURM_SUBMIT_DIR"

declare -A SRUN_PIDS

check_srun_processes() {
  for name in "${!SRUN_PIDS[@]}"; do
    pid="${SRUN_PIDS[$name]}"
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "[ERROR] Background srun '$name' died." >&2
      touch "$LOG_DIR/ENDED"
      exit 1
    fi
  done
}

# Resolve Node IPs
nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST")
nodes_array=($nodes)
ip_addresses_array=()

for node in $nodes; do
    ip_address=$(host $node 2>/dev/null | awk '/has address/ { print $4 }' | head -1 || getent hosts $node | awk '{print $1}' | head -1 || echo $node)
    ip_addresses_array+=("$ip_address")
done

head_node=${nodes_array[0]}
head_node_ip=${ip_addresses_array[0]}
export RAY_HEAD_IP=$head_node_ip
ip_head=$head_node_ip:$PORT

########################################################
# Start Ray Head
########################################################
head_cmd=$(cat <<EOF
touch $LOG_DIR/STARTED_RAY_HEAD
ray start --head \
    --disable-usage-stats \
    --resources="{\"worker_units\": $GPUS_PER_NODE}" \
    --node-ip-address="$head_node_ip" \
    --port=${PORT} \
    --dashboard-host="$head_node_ip" \
    --node-manager-port=${NODE_MANAGER_PORT} \
    --object-manager-port=${OBJECT_MANAGER_PORT} \
    --runtime-env-agent-port=${RUNTIME_ENV_AGENT_PORT} \
    --dashboard-agent-grpc-port=${DASHBOARD_AGENT_GRPC_PORT} \
    --metrics-export-port=${METRICS_EXPORT_PORT} \
    --dashboard-agent-listen-port=${DASHBOARD_AGENT_LISTEN_PORT} \
    --min-worker-port=${MIN_WORKER_PORT} \
    --max-worker-port=${MAX_WORKER_PORT} \
    --block
EOF
)
srun $COMMON_SRUN_ARGS --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$head_node" -o $LOG_DIR/ray-head.log bash -c "$head_cmd" &
SRUN_PIDS["ray-head"]=$!

########################################################
# Start Ray Workers
########################################################
for ((i = 1; i < SLURM_JOB_NUM_NODES; i++)); do
  node_i=${nodes_array[$i]}
  worker_cmd="ray start --address $ip_head --resources=\"{\\\"worker_units\\\": $GPUS_PER_NODE}\" --node-manager-port=${NODE_MANAGER_PORT} --object-manager-port=${OBJECT_MANAGER_PORT} --runtime-env-agent-port=${RUNTIME_ENV_AGENT_PORT} --dashboard-agent-grpc-port=${DASHBOARD_AGENT_GRPC_PORT} --metrics-export-port=${METRICS_EXPORT_PORT} --dashboard-agent-listen-port=${DASHBOARD_AGENT_LISTEN_PORT} --min-worker-port=${MIN_WORKER_PORT} --max-worker-port=${MAX_WORKER_PORT} --block"
  srun $COMMON_SRUN_ARGS --exact --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$node_i" -o $LOG_DIR/ray-worker-$i.log bash -c "$worker_cmd" &
  SRUN_PIDS["ray-worker-$i"]=$!
done

# Wait for Head
while check_srun_processes && ! srun --overlap --nodes=1 -w $head_node test -f $LOG_DIR/STARTED_RAY_HEAD; do
  sleep 2
done

########################################################
# Start ICPC Sandbox (Overlap on Head Node)
########################################################
if [[ -n "${SANDBOX_CONTAINER:-}" ]]; then
  echo "[INFO] Launching ICPC Sandbox on $head_node..."
  srun --output "$LOG_DIR/sandbox.log" \
    --error "$LOG_DIR/sandbox.log" \
    --container-image="$SANDBOX_CONTAINER" \
    --container-mounts="$MOUNTS" \
    --no-container-mount-home \
    --overlap --nodes=1 -w "$head_node" \
    bash -c "$SANDBOX_COMMAND" &
  SRUN_PIDS["sandbox"]=$!
fi

########################################################
# Wait for Cluster Readiness
########################################################
get_container_pid() {
  srun --overlap --nodes=1 -w "$1" bash -c "enroot list -f | awk 'NR>1 && \$2 ~ /^[0-9]+\$/ {print \$2; exit}'"
}

NUM_ACTORS=$((GPUS_PER_NODE * SLURM_JOB_NUM_NODES))
while true; do
  head_pid=$(get_container_pid "$head_node")
  if [[ -n "$head_pid" ]]; then
    worker_units=$(srun --overlap --nodes=1 -w "$head_node" enroot exec "$head_pid" ray status | grep "worker_units" | awk -F'[/. ]' '{print $4}' || echo 0)
    echo "[INFO] Actors online: $worker_units/$NUM_ACTORS"
    [[ "$worker_units" -ge "$NUM_ACTORS" ]] && break
  fi
  check_srun_processes
  sleep 5
done

########################################################
# Run RL Training Command
########################################################
CONTAINER_CWD=$(scontrol show job $SLURM_JOB_ID | grep -oP 'WorkDir=\K[^ ]+' | head -1)
if [[ -n "$COMMAND" ]]; then
  head_pid=$(get_container_pid "$head_node")
  # Inject RAY_HEAD_IP into the enroot exec environment
  srun --overlap --nodes=1 -w "$head_node" -o $LOG_DIR/ray-driver.log \
    enroot exec --env RAY_HEAD_IP="$RAY_HEAD_IP" "$head_pid" bash -c "cd $CONTAINER_CWD && $COMMAND"
else
  echo "[INFO] Ray Cluster IDLE. Use enroot exec $head_pid to attach."
  sleep infinity
fi